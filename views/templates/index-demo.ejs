    <div id="ferrari-intro" class="splash-container">
    <div id="splash-content-block" class="splash-content">
        <h1 class="splash-logo">
            LA<span class="splash-highlight">SI</span>
        </h1>
        <div class="splash-loader"></div>
    </div>
</div>

<style>
    .splash-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: #000000;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 1;
        visibility: visible;
        /* Transição suave da tela preta sumindo (reduzida para 1s) */
        transition: opacity 1s cubic-bezier(0.25, 1, 0.5, 1), 
                    visibility 1s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .splash-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        opacity: 1;
        /* Transição exclusiva para as letras sumirem antes de tudo */
        transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1),
                    transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .splash-logo {
        font-family: var(--font-michroma, 'Michroma', sans-serif);
        font-size: 4rem;
        color: #ffffff;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        white-space: nowrap;
        opacity: 0;
        transform: scale(0.92);
        animation: logoReveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.2s;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }

    .splash-highlight {
        color: var(--brand-yellow, #fccc06);
        text-shadow: 0 0 25px rgba(252, 204, 6, 0.5);
    }

    .splash-loader {
        width: 0;
        height: 2px;
        background: linear-gradient(to right, transparent, var(--brand-yellow, #fccc06), transparent);
        animation: lineLoad 1.6s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.4s;
    }

    /* --- CLASSES DE DESAPARECIMENTO (DISPARADAS PELO JS) --- */

    /* Etapa 1: Apaga as letras primeiro e dá um leve efeito de encolhimento */
    .splash-content.content-fade-out {
        opacity: 0;
        transform: scale(0.95);
    }

    /* Etapa 2: Apaga a cortina preta de fundo */
    .splash-container.fade-out {
        opacity: 0;
        visibility: hidden;
    }

    /* --- TIMELINE DE ANIMAÇÕES INTERNAS --- */
    @keyframes logoReveal {
        to {
            opacity: 1;
            transform: scale(1);
            letter-spacing: 0.2em;
        }
    }

    @keyframes lineLoad {
        to {
            width: 180px;
        }
    }

    body.intro-active {
        overflow: hidden !important;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const splash = document.getElementById("ferrari-intro");
        const splashContent = document.getElementById("splash-content-block");
        
        document.body.classList.add("intro-active");

        /* ==========================================
           TIMELINE DE TEMPO (DURAÇÃO REDUZIDA)
           ========================================== */
        
        // 1. As letras brilham por apenas 1.8 segundos (antes eram 3s)
        const tempoExibicaoLetras = 1800; 
        
        // 2. Tempo de espera para a tela preta sumir LOGO APÓS as letras sumirem
        const delayTelaPreta = 600; 

        // Passo 1: Desaparecer apenas com as letras (LASI)
        setTimeout(() => {
            splashContent.classList.add("content-fade-out");
            
            // Passo 2: Logo em seguida, remove a cortina de fundo preto
            setTimeout(() => {
                splash.classList.add("fade-out");
                document.body.classList.remove("intro-active");

                // Passo 3: Limpeza completa do HTML após o término do efeito
                setTimeout(() => {
                    splash.remove();
                }, 1000); // Combinando com 1s de transição da splash-container

            }, delayTelaPreta);

        }, tempoExibicaoLetras);
    });
</script>
    
