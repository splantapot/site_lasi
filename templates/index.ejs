<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Main</title>
</head>
<body>
    <h1>Main</h1>
    <p>Data from Google Sheets:</p>
    <h2>Eventos</h2>
    <div>
        <% eventos.forEach(e => { %>
            <h4><%= e.titulo %></h4>
            <label>Data: <%= e.data %></label><br>
        <% }) %>
    </div>
    <h2>Membros</h2>
    <div>
        <% membros.forEach(m => { %>
            <h4><%= m.nome %></h4>
            <label>Função: <%= m.funcao %></label><br>
        <% }) %>
    </div>
</body>
</html>