<style>
    /* --- RESET INTERNO DO MAIN --- */
    html {
        scroll-behavior: smooth;
    }

    /* --- CONTAINER PRINCIPAL --- */
    /* Aplica o gradiente suavizado anti-linhas + textura de ruído + fundo escuro corrigido */
    .main-container {
        width: 100%;
        min-height: calc(100vh - 75px); /* Desconta a altura do seu header */
        background-color: var(--slate-bg-end);
        background-image: 
            url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.015'/%3E%3C/svg%3E"),
            linear-gradient(
                to bottom,
                var(--slate-bg-start) 0%,
                #151a21 6.7%,
                #13181f 13.3%,
                #11161d 20%,
                #10141a 26.7%,
                #0e1218 33.3%,
                #0c1016 40%,
                var(--slate-bg-mid) 46.7%,
                #0b0f15 53.3%,
                #090c12 60%,
                #070a0f 66.7%,
                #05080c 73.3%,
                #03060a 80%,
                #020407 86.7%,
                #010204 93.3%,
                var(--slate-bg-end) 100
            );
        background-attachment: fixed;
        background-size: cover;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 80px;
        padding-bottom: 80px;
    }

    /* --- ESTRUTURA DO CARROSSEL (FADE EFFECT) --- */
    .carousel-section {
        width: 100%;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
        height: 70vh; /* Altura ideal na tela */
        overflow: hidden;
        border-bottom: 2px solid rgba(252, 204, 6, 0.2);
    }

    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        z-index: 1;
        transition: opacity 1.2s ease-in-out;
        display: flex;
        align-items: center;
        background-size: cover;
        background-position: center;
    }

    /* O slide ativo ganha opacidade e sobrepõe os outros */
    .carousel-slide.active {
        opacity: 1;
        z-index: 2;
    }

    /* Overlay escuro em degradê para garantir leitura do texto à esquerda */
    .carousel-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, rgba(1, 4, 9, 0.95) 25%, rgba(1, 4, 9, 0.4) 100%);
        z-index: 3;
    }

    /* Bloco de conteúdo interno do Carrossel */
    .carousel-content {
        position: relative;
        z-index: 4;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 40px;
        transform: translateY(15px);
        opacity: 0;
        transition: all 0.8s ease-out 0.3s;
    }

    /* Animação interna do texto quando o slide ativa */
    .carousel-slide.active .carousel-content {
        transform: translateY(0);
        opacity: 1;
    }

    .carousel-tag {
        color: var(--brand-yellow);
        font-family: var(--font-michroma);
        font-size: var(--text-xs, 0.75rem);
        letter-spacing: 3px;
        text-transform: uppercase;
        display: block;
        margin-bottom: 16px;
    }

    .carousel-title {
        font-family: var(--font-michroma);
        font-size: var(--text-2xl);
        line-height: 1.2;
        margin-bottom: 20px;
        color: #ffffff;
    }

    .text-gradient {
        background: linear-gradient(135deg, #ffffff 40%, var(--brand-yellow));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .carousel-desc {
        font-size: var(--text-base);
        color: var(--text-muted);
        max-width: 580px;
        line-height: 1.6;
        margin-bottom: 35px;
    }

    /* Botão Premium do LASI */
    .btn-lasi {
        display: inline-block;
        padding: 14px 32px;
        background-color: var(--brand-yellow);
        color: var(--slate-bg-end);
        font-weight: 700;
        text-decoration: none;
        border-radius: 4px;
        font-family: var(--font-michroma);
        font-size: 0.8rem;
        letter-spacing: 1px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-lasi:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(252, 204, 6, 0.25);
    }

    /* Indicadores de bolinhas (Dots) */
    .carousel-dots {
        position: absolute;
        bottom: 32px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        gap: 12px;
        z-index: 5;
    }

    .dot {
        width: 30px;
        height: 4px;
        background: rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .dot.active {
        background: var(--brand-yellow);
        width: 60px; /* Efeito estendido na bolinha ativa */
    }

    /* --- GRID DE RECURSOS (CARDS) --- */
    .features-section {
        width: 100%;
        max-width: 1200px;
        padding: 0 40px;
    }

    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 24px;
    }

    .feature-card {
        background-color: rgba(22, 27, 34, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 36px;
        border-radius: 8px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .feature-card h3 {
        font-family: var(--font-michroma);
        font-size: var(--text-md);
        margin: 16px 0 12px 0;
        color: #ffffff;
    }

    .feature-card p {
        font-size: var(--text-sm);
        color: var(--text-muted);
        line-height: 1.6;
    }

    .card-icon {
        font-size: 1.8rem;
    }

    /* Interações do Card comum */
    .feature-card:hover {
        transform: translateY(-5px);
        border-color: rgba(255, 255, 255, 0.12);
        background-color: rgba(22, 27, 34, 0.6);
    }

    /* Card com Destaque em Amarelo */
    .feature-card.highlighted {
        border-color: rgba(252, 204, 6, 0.15);
        background-color: rgba(252, 204, 6, 0.01);
    }

    .feature-card.highlighted:hover {
        border-color: var(--brand-yellow);
    }

    /* --- RESPONSIVIDADE (MOBILE) --- */
    @media (max-width: 768px) {
        .carousel-wrapper { height: 60vh; }
        .carousel-title { font-size: var(--text-xl, 2rem); }
        .carousel-content { padding: 0 24px; }
        .features-section { padding: 0 24px; }
        .main-container { gap: 48px; }
    }
</style>

<script>
    (function() {
        let currentIdx = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('.dot');
        let timer = null;

        // Altera o slide com base no índice numérico
        window.setSlide = function(index) {
            // Remove estados ativos atuais
            slides[currentIdx].classList.remove('active');
            dots[currentIdx].classList.remove('active');
            
            currentIdx = index;
            
            // Adiciona estados ativos no novo slide selecionado
            slides[currentIdx].classList.add('active');
            dots[currentIdx].classList.add('active');
            
            // Reseta o temporizador para evitar pulos duplos ao clicar manualmente
            resetAutoPlay();
        };

        function nextSlide() {
            let next = (currentIdx + 1) % slides.length;
            setSlide(next);
        }

        function resetAutoPlay() {
            clearInterval(timer);
            timer = setInterval(nextSlide, 6000); // Avança automaticamente a cada 6 segundos
        }

        // Inicializa o autoplay na carga da página
        resetAutoPlay();
    })();
</script>

    <!-- Scripts -->
    <script src="./js/navigation-bar.js"></script>
</body>
</html>